<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HolyPeak</AssemblyName>
    <RootNamespace>HolyPeak</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Holy Peak</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <EmbeddedResource Include="World/world.txt" LogicalName="world.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

</Project>
